# Build
/build/
/app/build/
/.gradle/
/.kotlin/
local.properties

# Gradle wrapper jar/scripts are generated by `gradle wrapper` (not committed by default;
# many projects DO commit them — if you prefer, remove these two lines and run
# `gradle wrapper` then commit gradlew + gradle/wrapper/).
/gradlew
/gradlew.bat
/gradle/wrapper/gradle-wrapper.jar

# Proprietary native libraries — user-supplied, NOT redistributed in this open-source repo.
# Copy them from your own HxdIR.apk (lib/armeabi/) before building if you want the
# NativeIrCodec shim (see BUILD.md). The app builds and runs without them (clean codec).
/app/src/main/jniLibs/

# Reverse-engineering workspace (decompiled proprietary material — do not redistribute)
/HxdIR.apk
/apk-raw/
/jadx-src/
/jadx-res/
/re/*.so
ir_tools.disasm.txt

# macOS
.DS_Store
